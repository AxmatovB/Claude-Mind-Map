# Copy this file to .env and point each variable at the real path on your
# machine. docker-compose.yml reads these to bind-mount your agent config
# directories read-only into the container. If you don't have one of the
# three agents installed, delete its line here AND comment out the matching
# volume line in docker-compose.yml.

CLAUDE_HOME_DIR=C:/Users/<you>/.claude
CODEX_HOME_DIR=C:/Users/<you>/.codex
GEMINI_HOME_DIR=C:/Users/<you>/.gemini
